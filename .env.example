# URL do aplicativo usada pelos CTAs de login e pela navbar.
# Em desenvolvimento local, aponte para o app rodando em http://localhost:8000.
VITE_APP_URL=http://localhost:8000

# Endpoint oficial que recebe os leads do formulário de demonstração via POST JSON.
# Contrato: POST /api/public/website-leads
# Quando vazio, o formulário abre o cliente de e-mail com os dados preenchidos.
VITE_LEAD_ENDPOINT=http://localhost:8000/api/public/website-leads
